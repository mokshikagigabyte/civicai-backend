# Python
__pycache__/
*.py[cod]
*$py.class
venv/
ENV/
.venv/
env/

# Environment variables (NEVER commit real secrets)
.env
.env.local
.env.*.local
# But DO track the example template:
!.env.example

# Large AI/ML binary files (too big for GitHub, rebuild locally)
*.faiss
*.npy
*.pkl

# Large JSON data files (generated by scripts, not source code)
motor_vehicles_chunked.json
motor_vehicles_db_improved.json
motor_vehicles_embedded.json
motor_vehicles_db.json
# Keep the original source DB if needed:
# !motor_vehicles_db.json

# Analysis output logs (auto-generated)
analysis_output*.txt
flutter_*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python packaging artifacts
dist/
build/
*.egg-info/

# Flutter Mobile (build artifacts only — source code IS tracked)
legal_ai_mobile/build/
legal_ai_mobile/.dart_tool/
legal_ai_mobile/.flutter-plugins
legal_ai_mobile/.flutter-plugins-dependencies
legal_ai_mobile/.pub-cache/
legal_ai_mobile/android/app/debug/
legal_ai_mobile/android/app/profile/
legal_ai_mobile/android/app/release/
